{
  "name": "webapp",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build -c vite.server.config.ts && echo _worker.js > dist/.assetsignore",
    "typecheck": "tsc -p tsconfig.json",
    "preview": "wrangler dev --ip 0.0.0.0 --port 3000",
    "deploy": "npm run build && wrangler deploy",
    "clean-port": "fuser -k 3000/tcp 2>/dev/null || true",
    "health": "curl -s http://localhost:3000/api/health",
    "test": "npm run -s test:merge && npm run -s test:sync && npm run -s test:branch && npm run -s test:stroke && npm run -s test:css && npm run -s test:flip && npm run -s test:motion",
    "test:stroke": "node --experimental-strip-types --no-warnings tools/verify/stroke-shape-test.ts",
    "test:motion": "node --experimental-strip-types --no-warnings tools/verify/motion-dom-sim.ts",
    "test:flip": "node --experimental-strip-types --no-warnings tools/verify/flip-plan-test.ts",
    "test:merge": "node --experimental-strip-types --no-warnings tools/verify/merge-test.ts",
    "test:sync": "node --experimental-strip-types --no-warnings tools/verify/sync-judge-test.ts",
    "test:branch": "node --experimental-strip-types --no-warnings tools/verify/branch-test.ts",
    "test:css": "node --experimental-strip-types --no-warnings tools/verify/css-check.ts",
    "test:e2e": "node --experimental-strip-types --no-warnings tools/e2e/run.ts"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "fflate": "^0.8.3",
    "hono": "^4.13.8",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "perfect-freehand": "^1.2.3",
    "rbush": "^4.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@types/node": "^26.6.4",
    "@types/rbush": "^4.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  }
}
