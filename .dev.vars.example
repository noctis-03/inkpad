# Cloudflare Pages 로컬 개발용 환경 변수 (npx wrangler pages dev가 읽는다)
# .dev.vars 파일로 복사하고 값을 채우세요. 절대 커밋하지 마세요 (.gitignore에 이미 있음)
GOOGLE_CLIENT_ID=1234-abc.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPx-...
# openssl rand -base64 32
SESSION_SECRET=...
# 지정하면 이 계정 외 로그인을 차단한다 (선택)
# ALLOWED_EMAIL=me@gmail.com
